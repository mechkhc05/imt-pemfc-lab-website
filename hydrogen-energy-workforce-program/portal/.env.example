# SQLite file used by Prisma. Copy this file to .env and adjust if needed.
DATABASE_URL="file:./dev.db"

# Random secret used to sign session JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="replace-with-a-random-64-char-hex-string"

# Optional: override seeded demo account passwords
# SEED_ADMIN_PASSWORD=admin1234!
# SEED_REVIEWER_PASSWORD=reviewer1234!

# Optional: where uploaded photos/attachments are stored. Defaults to public/uploads.
# On a hosting platform with a persistent volume (e.g. Railway), point this at the
# volume's mount path so uploads survive redeploys, e.g.:
# UPLOADS_ROOT=/data/uploads
